#!/bin/sh
# git gpg.ssh.program: load the signing key into the agent first, so the
# passphrase is asked once per agent timeout instead of on every commit.

if [ $# -eq 0 ]; then
    echo "usage: called by git as gpg.ssh.program" >&2
    exit 2
fi

key=
prev=
for arg; do
    [ "$prev" = -f ] && key=$arg
    prev=$arg
done
if [ -n "$key" ] && ! ssh-add -T "$key" >/dev/null 2>&1; then
    ssh-add "${key%.pub}" || true
fi

exec ssh-keygen "$@"
