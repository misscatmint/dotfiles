[alias]
	ci = commit
	dc = diff --cached
	dft = difftool
	st = status
	in = log ..@{upstream}
	out = log @{upstream}..
[commit]
	gpgsign = true
[core]
	pager = delta
[delta]
	navigate = true
[diff]
	renames = copies
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[include]
	path = local
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[tag]
	gpgsign = true
